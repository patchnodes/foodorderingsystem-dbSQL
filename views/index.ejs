<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Order System</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <!-- Form container -->
    <div class="section-container">
        <div class="form-column">
            <section class="form-section">
                <div class="form-container">
                    <h1>Please select your order</h1>
                    <form action="/add" method="POST">
                        <label for="item"></label>
                        <select id="item" name="item" onchange="updatePrice()" required>
                            <!-- Dropdown food items -->
                            <option value="">Select an item</option>
                            <optgroup label="Burgers">
                                <option value="McBeef">McBeef</option>
                                <option value="McChicken">McChicken</option>
                            </optgroup>
                            <optgroup label="Sides">
                                <option value="Fries">Fries</option>
                                <option value="Poutine">Poutine</option>
                                <option value="Baked Apple Pie">Baked Apple Pie</option>
                            </optgroup>
                            <optgroup label="Desserts">
                                <option value="McFlurry">McFlurry</option>
                                <option value="Hot Fudge Sundae">Hot Fudge Sundae</option>
                                <option value="Vanilla Ice Cream">Vanilla Ice Cream</option>
                            </optgroup>
                            <optgroup label="Beverages">
                                <option value="McFloat">McFloat</option>
                                <option value="Diet Coke">Diet Coke</option>
                                <option value="Sprite">Sprite</option>
                                <option value="Water">Water</option>
                            </optgroup>
                        </select><br>
                        
                        <label for="quantity"></label>
                        <select id="quantity" name="quantity" onchange="updatePrice()" required>
                            <option value="">Select quantity</option>
                            <!-- This autopopulates the price of the item when a number of quantity is selected -->
                            <% for (let i = 1; i <= 20; i++) { %>
                                <option value="<%= i %>"><%= i %></option>
                            <% } %>
                        </select><br>
                        <label for="price">Total</label>
                        <input type="number" id="price" name="price" step="0.01" readonly required><br><br>
                        <input type="hidden" id="recordId" name="recordId">
                        <button type="submit">Order</button>
                    </form>
                </div>
            </section>
        </div>
        
        <div class="table-column">
            <section class="table-section">
                <h1>Ordered Items</h1>
                <table border="1" id="record-table">
                    <tr>
                        <th>ID</th>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Action</th>
                    </tr>
                    <% records.forEach(record => { %>
                        <tr id="record-<%= record.id %>">
                            <td><%= record.id %></td>
                            <td><%= record.item %></td>
                            <td><%= record.quantity %></td>
                            <td class="price"><%= record.price %></td>
                            <td>
                                <button class="remove-button" onclick="removeItem(<%= record.id %>)">Remove</button></br></br>
                                <button class="update-button" onclick="updateItem(<%= record.id %>, '<%= record.item %>', <%= record.quantity %>)">Update</button>
                            </td>
                        </tr>
                    <% }); %>
                </table>
                <div id="total-price-section">
                    <h1>Total Price: <%= totalPrice.toFixed(2) %></h1>
                </div>
                <button onclick="buyNow()">Buy Now</button>
            </section>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
        function updatePrice() {
            const item = document.getElementById('item').value;
            const quantity = document.getElementById('quantity').value;
            let price;

            switch (item) {
                case 'McBeef':
                    price = 3.59 * quantity;
                    break;
                case 'McChicken':
                    price = 2.73 * quantity;
                    break;
                case 'Fries':
                    price = 1.38 * quantity;
                    break;
                case 'Poutine':
                    price = 2.89 * quantity;
                    break;
                case 'Baked Apple Pie':
                    price = 1.99 * quantity;
                    break;
                case 'McFlurry':
                    price = 2.94 * quantity;
                    break;
                case 'Hot Fudge Sundae':
                    price = 1.28 * quantity;
                    break;
                case 'Vanilla Ice Cream':
                    price = 0.99 * quantity;
                    break;
                case 'McFloat':
                    price = 1.94 * quantity;
                    break;
                case 'Diet Coke':
                case 'Sprite':
                    price = 1.50 * quantity;
                    break;
                case 'Water':
                    price = 2.99 * quantity;
                    break;
                default:
                    price = 0;
            }

            document.getElementById('price').value = price.toFixed(2);
        }

        function removeItem(id) {
            if (!confirm('Are you sure you want to delete this item?')) return;

            fetch(`/remove/${id}`, { method: 'POST' })
            .then(response => {
                if (response.ok) {
                    // Reloads the page after successfully removing the item
                    location.reload();
                } else {
                    alert('Failed to delete the item.');
                }
            })
        }


        function updateItem(id, item, quantity) {
            document.getElementById('item').value = item;
            document.getElementById('quantity').value = quantity;
            document.getElementById('price').value = (getItemPrice(item) * quantity).toFixed(2);
            document.getElementById('recordId').value = id;
            document.getElementById('submitButton').innerText = 'Update Record';
            document.getElementById('addButton').style.display = 'none';
        }

        function getItemPrice(item) {
            switch (item) {
                case 'McBeef':
                    return 3.59;
                case 'McChicken':
                    return 2.73;
                case 'Fries':
                    return 1.15;
                case 'Poutine':
                    return 2.89;
                case 'Baked Apple Pie':
                    return 1.99;
                case 'McFlurry':
                    return 2.94;
                case 'Hot Fudge Sundae':
                    return 1.28;
                case 'Vanilla Ice Cream':
                    return 0.99;
                case 'McFloat':
                    return 1.94;
                case 'Diet Coke':
                case 'Sprite':
                    return 1.50;
                case 'Water':
                    return 2.99;
                default:
                    return 0;
            }
        }

        function updateTotal() {
            const rows = document.querySelectorAll('#record-table .price');
            let total = 0;
            rows.forEach(row => {
                total += parseFloat(row.textContent);
            });
            document.getElementById('total-price').textContent = total.toFixed(2);
        }

        function buyNow() {
            if (confirm("Are you sure you want to proceed with your order?")) {
                alert("Thank you for your order!");
                // Clear the records table
                const table = document.getElementById('record-table');
                table.innerHTML = '<tr><th>ID</th><th>Item</th><th>Quantity</th><th>Price</th><th>Action</th></tr>';
                // Update the total price to 0
                document.getElementById('total-price-section').innerHTML = '<h1>Total Price: 0.00</h1>';
            }
        }


            

    </script>
</body>
</html>
